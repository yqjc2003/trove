# 复制为 .env.local 后填入真实值；.env.local 已被 .gitignore 忽略，绝不提交。

# Supabase 项目地址与公开匿名 key（可暴露给浏览器）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 服务端专用：service role key。绕过 RLS，绝不能带 NEXT_PUBLIC_ 前缀。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 站点地址（生产环境用于 MCP / Skill 回调与绝对链接）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 提供给外部 Codex Skill 的公开 API 地址；本地联调才改为 http://localhost:3000/api/trove。
CATCHLINGER_AGENT_API_BASE=https://catchlinger.sxyicheng.tech/api/trove

# 仅供 `pnpm db:push` 使用：Supabase pooler 连接串（迁移工具读它，应用运行时不读）
# 取自 Dashboard → Project Settings → Database → Connection string（Session pooler, 端口 5432）
# 用户名必须带项目 ref：postgres.<项目ref>
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-xx-yyy.pooler.supabase.com:5432/postgres

{
  "manifest_version": 3,
  "name": "拾藏 CatchLinger",
  "version": "0.1.0",
  "description": "将当前网址交给本机拾藏客户端收录。",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "拾藏", "default_popup": "popup.html" },
  "options_page": "options.html"
}
